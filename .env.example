# ---------------------------------------------------------------------------
# Gastech — environment (copy to .env.local for local dev)
# ---------------------------------------------------------------------------

# Canonical absolute origin used for SEO metadata, sitemap.xml, robots.txt and
# JSON-LD. Set to the live domain in production (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://gastechcombustions.in"

# Where enquiry emails are addressed. Placeholder stage simply logs the payload
# and returns success; the "to" is kept here so wiring a real sender is a
# one-line change later.
ENQUIRY_TO_EMAIL="sales@gastechcombustions.in"
ENQUIRY_TECHNICAL_EMAIL="technical@gastechcombustions.in"

# --- Later: real transport (leave blank to keep the placeholder behaviour) ---
# Option A — Resend (recommended on a Node host):
# RESEND_API_KEY=""
# Option B — SMTP with the company's own mailbox:
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# Option C — a hosted form endpoint (works even with a static export):
# FORMSPREE_ID=""
